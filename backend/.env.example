# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/policypal?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AWS S3 (or compatible like MinIO)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-west-1
S3_BUCKET=policypal-documents
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Government Data APIs (Ireland)
FLOOD_DATA_URL=https://data.gov.ie/dataset/flood-maps
CRIME_STATS_URL=https://data.cso.ie/
EIRCODE_API_KEY=your-eircode-api-key

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Feature Flags
ENABLE_OCR=true
MAX_FILE_SIZE_MB=50
PDF_RETENTION_DAYS=30

# Logging
LOG_LEVEL=debug
